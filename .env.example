# Backend
NODE_ENV=production
PORT=3001
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN_DAYS=30
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MAX_INPUT_CHARS=20000
DATABASE_URL=postgresql://postgres:postgrespw@localhost:5432/docstruct
REDIS_URL=
CORS_ORIGIN=https://your-frontend-domain.com
COOKIE_SAME_SITE=lax
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=your-smtp-user
MAIL_PASS=your-smtp-password
MAIL_FROM=no-reply@docstruct.ai
MAIL_SECURE=true

# Frontend
VITE_API_BASE_URL=https://docstruct-backend.onrender.com
